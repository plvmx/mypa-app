# Copy this file to `.env.local` and fill in the values from your NEW Supabase
# project (Settings → API). Do NOT reuse the AFJ campaign-app project.
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored and never committed.

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" key (safe to expose to the browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
